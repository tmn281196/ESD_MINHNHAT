<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="ESDCloudViewer.App" StartupUri="MainWindow.xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- UI strings; MainWindow switches this to the language saved in cloudviewer.json (see Lang/Lang.cs) -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Lang/Strings.en.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
      </Style>
      <!-- Same fonts as ESDCMS (linked from ../ESDCMS/Fonts): Google Sans for the UI, JetBrains Mono for the console log.
           Glyphs they do not have (Korean, Thai) fall back to the Windows UI font automatically. -->
      <FontFamily x:Key="AppFont">pack://application:,,,/ESDCloudViewer;component/Fonts/#Google Sans</FontFamily>
      <FontFamily x:Key="MonoFont">pack://application:,,,/ESDCloudViewer;component/Fonts/#JetBrains Mono</FontFamily>
      <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
