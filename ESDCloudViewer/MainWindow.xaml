<?xml version="1.0" encoding="utf-8"?>
<!-- Same template as ESDCMS: title bar (language button at the right), main area (legend + content), PowerShell-blue
     Console Log (always English), bottom bar with a framed group. Colours and button styles copied from ESDCMS MainWindow. -->
<Window x:Class="ESDCloudViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp" Title="ESD Cloud Viewer" Height="900" Width="1400" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen" Icon="app.ico" FontFamily="{StaticResource AppFont}" Background="#FFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="MotorButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10 0" />
        <Setter Property="Margin" Value="3 0 0 0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Background" Value="#556275" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Control.Background}" CornerRadius="0" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LangButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="#3E4C5E" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="#55647A" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="#4CAF50" />
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="#4CAF50" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="#3D8B40" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BarGroupBox" TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#55647A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0 3 8 3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GroupBox}">
              <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="#2B3746" CornerRadius="0">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Background="#3E4C5E" Padding="10 0">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.FontWeight="Bold" TextElement.FontSize="12" TextElement.Foreground="{TemplateBinding Foreground}" />
                  </Border>
                  <ContentPresenter Margin="{TemplateBinding Padding}" />
                </DockPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BarField" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="#C8D2DC" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8 0 4 0" />
      </Style>
      <Style x:Key="BarValue" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0 0 6 0" />
      </Style>
      <Style x:Key="LogBarButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ButtonBase}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#323F4E" />
        <Setter Property="Margin" Value="0 16 0 8" />
      </Style>
      <Style x:Key="LegendLabel" TargetType="{x:Type Label}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="200" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Title bar -->
    <Grid Background="#323F4E" Row="0">
      <Label Content="ESD Cloud Viewer" FontSize="30" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 16 0">
        <Button Name="LangButton" Style="{StaticResource LangButton}" Content="{DynamicResource S.LangName}" ToolTip="{DynamicResource S.Tip.Language}" Click="LangButton_Click" />
      </StackPanel>
    </Grid>
    <!-- Main area: legend, gateway, boxes, latest status changes (built in code, MainWindow.Render) -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="15 10 15 15">
        <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 40 0">
            <Border Width="20" Height="20" Background="#FFFFFF00" />
            <Label Style="{StaticResource LegendLabel}" Content="{DynamicResource S.Inactive}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 40 0">
            <Border Width="20" Height="20" Background="#ff4500" />
            <Label Style="{StaticResource LegendLabel}" Content="{DynamicResource S.Warning}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 40 0">
            <Border Width="20" Height="20" Background="#45f248" />
            <Label Style="{StaticResource LegendLabel}" Content="{DynamicResource S.Active}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource S.Tip.Offline}">
            <Border Width="20" Height="20" Background="#037EF3" />
            <Label Style="{StaticResource LegendLabel}" Content="{DynamicResource S.Offline}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Name="NotWatchingText" Text="{DynamicResource S.Empty.NotWatching}" FontSize="16" Foreground="#5B6B7C" Margin="0 14 0 0" TextWrapping="Wrap" />
        <StackPanel Name="LivePanel">
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Sec.Gateway}" />
          <WrapPanel Name="GatewayPanel" />
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Sec.Boxes}" />
          <WrapPanel Name="BoxPanel" />
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Sec.Events}" />
          <StackPanel Name="EventPanel" MaxWidth="760" HorizontalAlignment="Left" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <!-- Console log: PowerShell-style blue background with white text, same as ESDCMS; lines stay in English -->
    <Grid Row="2" Background="#012456">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Background="#001A40" LastChildFill="False">
        <fa:IconImage DockPanel.Dock="Left" Icon="Terminal" Height="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8 0 6 0" />
        <TextBlock DockPanel.Dock="Left" Text="Console Log" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 5 0">
          <Button Style="{StaticResource LogBarButton}" Width="26" Height="26" Margin="1 0" Cursor="Hand" Background="#0A3570" ToolTip="{DynamicResource S.Tip.LogClear}" Click="ClearLog_Click">
            <fa:IconImage Icon="TrashCan" Height="13" Foreground="#DDDDDD" />
          </Button>
          <Button Style="{StaticResource LogBarButton}" Width="26" Height="26" Margin="1 0" Cursor="Hand" Background="#0A3570" ToolTip="{DynamicResource S.Tip.LogSave}" Click="SaveLog_Click">
            <fa:IconImage Icon="FloppyDisk" Height="13" Foreground="#DDDDDD" />
          </Button>
        </StackPanel>
      </DockPanel>
      <ScrollViewer Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
              <Setter Property="Width" Value="4" />
              <Setter Property="Background" Value="#00FFFFFF" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="#00FFFFFF">
                      <Track Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                          <Thumb MinHeight="24">
                            <Control.Template>
                              <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Name="ThumbBorder" CornerRadius="2" Background="#3D6AA8" Margin="1 0" />
                                <ControlTemplate.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Border.Background" Value="#5C88C4" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Control.Template>
                          </Thumb>
                        </Track.Thumb>
                      </Track>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl Name="LogList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Foreground="#FFFFFF" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="8 0" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <!-- Bottom bar: live state at the left edge; the Firebase group (line, database, buttons) at the right edge -->
    <Grid Row="3" Background="#323F4E">
      <DockPanel Margin="8 6" LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 10 0">
          <fa:IconImage Name="LiveIcon" Icon="Cloud" Height="16" Foreground="#9AA5B1" VerticalAlignment="Center" Margin="2 0 8 0" />
          <TextBlock Name="LiveText" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <GroupBox Style="{StaticResource BarGroupBox}" HorizontalAlignment="Right">
          <GroupBox.Header>
            <StackPanel Orientation="Horizontal">
              <fa:IconImage Name="GroupIcon" Icon="Database" Height="10" Foreground="#9AA5B1" VerticalAlignment="Center" Margin="0 0 5 0" />
              <TextBlock Text="Firebase" VerticalAlignment="Center" />
            </StackPanel>
          </GroupBox.Header>
          <StackPanel Orientation="Horizontal">
            <Label Style="{StaticResource BarField}" Content="{DynamicResource S.Line}" />
            <TextBlock Name="LineText" Style="{StaticResource BarValue}" Text="—" />
            <Label Style="{StaticResource BarField}" Content="{DynamicResource S.Db}" />
            <TextBlock Name="HostText" Style="{StaticResource BarValue}" Text="—" MaxWidth="320" TextTrimming="CharacterEllipsis" />
            <Button Name="SettingsButton" Style="{StaticResource MotorButton}" Margin="8 0 0 0" ToolTip="{DynamicResource S.Tip.Settings}" Click="Settings_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconImage Icon="Gear" Height="12" Foreground="#FFFFFF" Margin="0 0 6 0" />
                <TextBlock Text="{DynamicResource S.Btn.Settings}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="CheckButton" Style="{StaticResource MotorButton}" ToolTip="{DynamicResource S.Tip.Check}" Click="Check_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconImage Icon="ListCheck" Height="12" Foreground="#FFFFFF" Margin="0 0 6 0" />
                <TextBlock Text="{DynamicResource S.Btn.Check}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="WatchButton" Style="{StaticResource MotorButton}" ToolTip="{DynamicResource S.Tip.Watch}" Click="Watch_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconImage Icon="Play" Height="11" Foreground="#FFFFFF" Margin="0 0 6 0" />
                <TextBlock Text="{DynamicResource S.Btn.Watch}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="StopButton" Style="{StaticResource MotorButton}" ToolTip="{DynamicResource S.Tip.Stop}" Click="Stop_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconImage Icon="Stop" Height="11" Foreground="#FFFFFF" Margin="0 0 6 0" />
                <TextBlock Text="{DynamicResource S.Btn.Stop}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </GroupBox>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
