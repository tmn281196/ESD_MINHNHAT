<Window x:Class="ControlBoxSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Box Simulator — ESDCMS" Width="760" Height="560" Background="#F4F5F7"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">
    <!-- Port -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
      <TextBlock Text="COM port" VerticalAlignment="Center" FontWeight="SemiBold" />
      <ComboBox Name="PortBox" Width="110" Margin="8 0 0 0" IsEditable="True" VerticalAlignment="Center" />
      <Button Content="↻" Width="28" Margin="4 0 0 0" ToolTip="Refresh the port list" Click="Refresh_Click" />
      <Button Name="OpenBtn" Content="Open" Width="80" Margin="8 0 0 0" Click="Open_Click" />
      <TextBlock Name="PortState" Text="closed" Margin="10 0 0 0" VerticalAlignment="Center" Foreground="#757575" />
    </StackPanel>

    <!-- Behaviour -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 10 0 0">
      <CheckBox Name="EchoBox" Content="Reply with echo (ACK)" IsChecked="True" VerticalAlignment="Center"
                ToolTip="Untick to simulate a control box that does not answer: ESDCMS retries, then logs 'not acknowledged'" />
      <TextBlock Text="Echo delay" Margin="18 0 6 0" VerticalAlignment="Center" />
      <TextBox Name="DelayBox" Width="50" Text="10" VerticalAlignment="Center" TextAlignment="Center"
               ToolTip="Wait this long before echoing. More than ESDCMS's RX timeout (500 ms) = a timeout" />
      <TextBlock Text="ms" Margin="4 0 0 0" VerticalAlignment="Center" Foreground="#757575" />
      <Button Content="Reset all LOW" Margin="18 0 0 0" Padding="8 2" Click="Reset_Click"
              ToolTip="Like an Arduino reset: every channel LOW (all motors run)" />
    </StackPanel>

    <!-- Channels -->
    <UniformGrid Name="ChannelGrid" DockPanel.Dock="Top" Columns="4" Margin="0 12 0 0" />

    <!-- Conveyor -->
    <Border Name="ConveyorBanner" DockPanel.Dock="Top" Margin="0 10 0 0" Padding="10 6">
      <TextBlock Name="ConveyorText" FontSize="15" FontWeight="Bold" Foreground="White" />
    </Border>

    <!-- Log -->
    <DockPanel DockPanel.Dock="Top" Margin="0 12 0 4">
      <Button DockPanel.Dock="Right" Content="Clear log" Padding="8 1" Click="ClearLog_Click" />
      <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <ListBox Name="LogList" FontFamily="Consolas" FontSize="12" />
  </DockPanel>
</Window>
