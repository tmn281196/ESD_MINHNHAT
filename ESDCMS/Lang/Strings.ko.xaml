  <!-- Cloud option of the RF gateway: WiFi dialog (WifiDialog.cs) -->
  <sys:String x:Key="S.Tip.Cloud">클라우드 (RF 게이트웨이 WiFi): 박스 상태를 Firebase로 전송</sys:String>
