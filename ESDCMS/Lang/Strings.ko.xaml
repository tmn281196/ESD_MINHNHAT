  <sys:String x:Key="S.Wifi.Ssid">WiFi 이름 (SSID)</sys:String>
  <sys:String x:Key="S.Wifi.Password">비밀번호</sys:String>
  <sys:String x:Key="S.Wifi.Save">저장 후 전송</sys:String>
  <sys:String x:Key="S.Wifi.Close">닫기</sys:String>
