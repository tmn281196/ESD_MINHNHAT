<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- UI strings, English. Same keys in Strings.ko.xaml and Strings.th.xaml; see Lang/Lang.cs. -->
  <sys:String x:Key="S.LangCode">en</sys:String>
  <sys:String x:Key="S.LangName">English</sys:String>

  <!-- Bottom bar -->
  <sys:String x:Key="S.RfGateway">RF Gateway</sys:String>
  <sys:String x:Key="S.ControlBox">Control Box</sys:String>
  <sys:String x:Key="S.Motors">Motors</sys:String>
  <sys:String x:Key="S.NetId">Net ID</sys:String>
  <sys:String x:Key="S.AskAgain">Ask again</sys:String>
  <sys:String x:Key="S.TxGap">TX gap</sys:String>
  <sys:String x:Key="S.RxTimeout">RX timeout</sys:String>
  <sys:String x:Key="S.Retry">Retry</sys:String>
  <sys:String x:Key="S.RetryGap">Retry gap</sys:String>
  <sys:String x:Key="S.StartAll">Start All</sys:String>
  <sys:String x:Key="S.Stop1">Stop 1</sys:String>
  <sys:String x:Key="S.Stop2">Stop 2</sys:String>
  <sys:String x:Key="S.Stop3">Stop 3</sys:String>
  <sys:String x:Key="S.Stop4">Stop 4</sys:String>
  <sys:String x:Key="S.RefreshConnection">Refresh Connection</sys:String>
  <sys:String x:Key="S.StartWithWindows">Start with Windows</sys:String>


  <!-- Monitor legend -->
  <sys:String x:Key="S.Inactive">Inactive</sys:String>
  <sys:String x:Key="S.Warning">Warning</sys:String>
  <sys:String x:Key="S.Active">Active</sys:String>
  <sys:String x:Key="S.Offline">Offline</sys:String>
  <sys:String x:Key="S.NotInUse">Not in use</sys:String>

  <!-- Offline alert on the map, just below the box row; {0} = box numbers -->
  <sys:String x:Key="S.Alert.Offline">Box {0} offline — please check the power supply and the wireless connection.</sys:String>

  <!-- Dialogs -->
  <sys:String x:Key="S.Unlock.Title">Unlock</sys:String>
  <sys:String x:Key="S.Unlock.Prompt">Enter the password to unlock the controls:</sys:String>
  <sys:String x:Key="S.Unlock.Wrong">Wrong password</sys:String>
  <sys:String x:Key="S.Unlock.Ok">Unlock</sys:String>
  <sys:String x:Key="S.Cancel">Cancel</sys:String>

  <!-- Tooltips -->
  <sys:String x:Key="S.Tip.Language">Display language - click to switch (English → 한국어 → ไทย)</sys:String>
  <sys:String x:Key="S.Tip.Refresh">Reconnect all COM ports (works even when locked)</sys:String>
  <sys:String x:Key="S.Tip.Lock">Lock / unlock the controls (unlocking needs the password; unlock to edit the settings)</sys:String>
  <sys:String x:Key="S.Tip.AutoStart">Open this program automatically when Windows starts</sys:String>
  <sys:String x:Key="S.Tip.RfStatus">Green = RF Gateway connected</sys:String>
  <sys:String x:Key="S.Tip.CbStatus">Green = Control Box connected</sys:String>
  <sys:String x:Key="S.Tip.RfPort">COM port of the RF Gateway - picking a port connects it, Close disconnects</sys:String>
  <sys:String x:Key="S.Tip.CbPort">COM port of the Control Box - picking a port connects it, Close disconnects</sys:String>
  <sys:String x:Key="S.Tip.NetId">LoRa Network ID (line) accepted from the RF Gateway</sys:String>
  <sys:String x:Key="S.Tip.AskAgain">Every this many seconds every box in use is asked for its status, one at a time (min 5). 0 = never</sys:String>
  <sys:String x:Key="S.Tip.TxGap">Delay between consecutive commands sent to the Control Box (ms)</sys:String>
  <sys:String x:Key="S.Tip.RxTimeout">How long to wait for the Control Box echo before a command counts as failed (ms)</sys:String>
  <sys:String x:Key="S.Tip.Retry">How many times a command to the Control Box is sent before giving up (first attempt included)</sys:String>
  <sys:String x:Key="S.Tip.RetryGap">Delay between two attempts of the same Control Box command (ms)</sys:String>
  <sys:String x:Key="S.Tip.LogToggle">Show / hide the log window (logging continues)</sys:String>
  <sys:String x:Key="S.Tip.LogClear">Clear log</sys:String>
  <sys:String x:Key="S.Tip.LogSave">Save log to a .txt file</sys:String>
  <sys:String x:Key="S.Tip.Tile">Click: ask this box for its status</sys:String>
  <!-- Cloud option of the RF gateway: WiFi dialog (WifiDialog.cs), cloud icon and console texts (Device/GatewayCloudText.cs) -->
  <sys:String x:Key="S.Tip.Cloud">Cloud (RF gateway WiFi): send the box states to Firebase</sys:String>
  <sys:String x:Key="S.Wifi.Title">RF Gateway WiFi (cloud)</sys:String>
  <sys:String x:Key="S.Wifi.Intro">The RF gateway can send the box states to the cloud (Firebase) over WiFi. The WiFi name and password are set in the gateway firmware (secrets.h, ENABLE_CLOUD 1); here the gateway's WiFi is only turned on or off.</sys:String>
  <sys:String x:Key="S.Wifi.Enable">Gateway joins WiFi (cloud)</sys:String>
  <sys:String x:Key="S.Wifi.Off">WiFi off</sys:String>
  <sys:String x:Key="S.Wifi.OnSent">WiFi turned on on the gateway.</sys:String>
  <sys:String x:Key="S.Wifi.OffSent">WiFi turned off on the gateway.</sys:String>
  <sys:String x:Key="S.Wifi.Unchanged">Saved; the gateway was already set so.</sys:String>
  <sys:String x:Key="S.Wifi.SavedNotSent">Saved; it is sent to the gateway when the RF Gateway is connected.</sys:String>
  <sys:String x:Key="S.Wifi.Save">Save &amp; send</sys:String>
  <sys:String x:Key="S.Wifi.Close">Close</sys:String>
  <sys:String x:Key="S.Wifi.NotConnected">The RF Gateway is not connected.</sys:String>
  <sys:String x:Key="S.Wifi.NoAnswer">No answer from the gateway: its firmware may be built without ENABLE_CLOUD.</sys:String>
  <sys:String x:Key="S.Wifi.State0">Gateway: WiFi off.</sys:String>
  <sys:String x:Key="S.Wifi.State1">Gateway: connecting to WiFi…</sys:String>
  <sys:String x:Key="S.Wifi.State2">Gateway: on WiFi ({0} dBm), connecting to the cloud…</sys:String>
  <sys:String x:Key="S.Wifi.State3">Gateway: WiFi OK ({0} dBm), cloud OK.</sys:String>
  <sys:String x:Key="S.Wifi.State4">Gateway: on WiFi ({0} dBm), cloud error.</sys:String>
  <sys:String x:Key="S.Wifi.State5">Gateway: cannot join the WiFi.</sys:String>
  <sys:String x:Key="S.Wifi.LastWrite">Last good write {0} ago.</sys:String>
  <sys:String x:Key="S.Cloud.Step1">joining the WiFi</sys:String>
  <sys:String x:Key="S.Cloud.Step2">setting the clock from the internet</sys:String>
  <sys:String x:Key="S.Cloud.Step3">signing in to Firebase</sys:String>
  <sys:String x:Key="S.Cloud.Step4">writing to the database</sys:String>
  <sys:String x:Key="S.Cloud.Now">Now: {0}.</sys:String>
  <sys:String x:Key="S.Cloud.LastTry">Last try: {0}.</sys:String>
  <sys:String x:Key="S.Cloud.FailedAt">Failed at {0}: {1}.</sys:String>
  <sys:String x:Key="S.Cloud.Why">Reason: {0}.</sys:String>
  <sys:String x:Key="S.Cloud.WifiNoAp">WiFi name (SSID) not found</sys:String>
  <sys:String x:Key="S.Cloud.WifiPassword">wrong WiFi password</sys:String>
  <sys:String x:Key="S.Cloud.WifiLost">WiFi signal lost</sys:String>
  <sys:String x:Key="S.Cloud.WifiTimeout">no answer from the WiFi</sys:String>
  <sys:String x:Key="S.Cloud.WifiReason">WiFi refused (reason {0})</sys:String>
  <sys:String x:Key="S.Cloud.NoInternet">no internet (name lookup fails)</sys:String>
  <sys:String x:Key="S.Cloud.NoTime">no time from the internet (NTP blocked?)</sys:String>
  <sys:String x:Key="S.Cloud.Dns">server name not found (no internet, or a wrong URL)</sys:String>
  <sys:String x:Key="S.Cloud.Tcp">cannot connect to the server</sys:String>
  <sys:String x:Key="S.Cloud.Tls">secure connection (TLS) failed</sys:String>
  <sys:String x:Key="S.Cloud.Cert">server certificate not trusted</sys:String>
  <sys:String x:Key="S.Cloud.NoAnswer">no answer from the server</sys:String>
  <sys:String x:Key="S.Cloud.NetError">connection error {0}</sys:String>
  <sys:String x:Key="S.Cloud.Login">wrong Firebase email or password</sys:String>
  <sys:String x:Key="S.Cloud.ApiKey">Firebase API key not valid</sys:String>
  <sys:String x:Key="S.Cloud.LoginOff">Email/Password sign-in is not enabled in Firebase</sys:String>
  <sys:String x:Key="S.Cloud.UserOff">Firebase user disabled</sys:String>
  <sys:String x:Key="S.Cloud.TooMany">too many attempts, Firebase asks to wait</sys:String>
  <sys:String x:Key="S.Cloud.BadEmail">Firebase email not valid</sys:String>
  <sys:String x:Key="S.Cloud.NoToken">no sign-in token in the answer</sys:String>
  <sys:String x:Key="S.Cloud.Denied">permission denied (database rules, gateways/&lt;UID&gt;)</sys:String>
  <sys:String x:Key="S.Cloud.NoDb">database not found (FIREBASE_DB_URL)</sys:String>
</ResourceDictionary>
