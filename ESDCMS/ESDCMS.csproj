<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>ESDCMS</RootNamespace>
    <AssemblyName>ESDCMS</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
    <!-- DPAPI (ProtectedData) for the gateway WiFi password in config.json -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\*.png" />
    <Resource Include="Monitoring\user.png" />
    <Resource Include="icon.ico" />
    <!-- UI fonts, same as the docs (SIL OFL 1.1): Google Sans + JetBrains Mono -->
    <Resource Include="Fonts\*.ttf" />
    <None Update="Fonts\LICENSE-*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
