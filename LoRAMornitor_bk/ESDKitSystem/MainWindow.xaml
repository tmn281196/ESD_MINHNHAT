<Window x:Class="ESDKitSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
          xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="ESD Compliance Monitoring System" Height="1000" Width="1920" Left="0" Top="0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="10*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="8*" />
            <RowDefinition Height="0.2*" />
        </Grid.RowDefinitions>

        <Label  Background="#323F4E" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalContentAlignment="Center"   VerticalContentAlignment="Center"  Content="ESD Compliance Monitoring System" FontSize="30"    Foreground="White" />





        <StackPanel Orientation="Vertical" Background="#323F4E" Grid.Row="1">
            <ToggleButton x:Name="btDeviceManagerPage" Click="btSelectPage_Click" Background="#52565e" Foreground="White" Height="30" FontSize="12">
                <fa:IconImage Margin="2" HorizontalAlignment="left" VerticalAlignment="Center" Foreground="White" Icon="Gears" />
            </ToggleButton>
            <ToggleButton x:Name="btLinePage" Click="btSelectPage_Click" Background="#52565e" Foreground="White" Height="30" FontSize="12">
                <fa:IconImage Margin="2" HorizontalAlignment="left" VerticalAlignment="Center" Foreground="White" Icon="Computer" />
            </ToggleButton>

        </StackPanel>


        <Grid Grid.Row="1" Grid.Column="1"  >
            <Frame  x:Name="DeviceManagerPageHolder"    Grid.Row="0"   Grid.Column="1"  Margin="5,5,5,5"   JournalOwnership="UsesParentJournal"     Navigated="DeviceManagerPageHolder_Navigated"  />
            <Frame  x:Name="MonitorPageHolder"    Grid.Row="0"   Grid.Column="1"  Margin="5,5,5,5"   JournalOwnership="UsesParentJournal"     Navigated="MonitorPageHolder_Navigated"  />
        </Grid>





        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"   Background="#323F4E" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Image Source="Images/TNGLogo.png"  />
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5 0"  Grid.Column="1"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Grid.Column="0">Version 4.0 - TNG Tech Co., Ltd</TextBlock>
                <StackPanel Orientation="Horizontal"
            Grid.Column="1"
            HorizontalAlignment="Right">
                    <!-- Control Box -->
                    <StackPanel Orientation="Horizontal"
 VerticalAlignment="Center"
 Margin="10 0">

                        <Label Padding="5 0"
Foreground="White"
VerticalAlignment="Center"
VerticalContentAlignment="Center">
                            Control Box
                        </Label>

                        <fa:IconImage Height="12"
       HorizontalAlignment="Left"
       VerticalAlignment="Center"
       Icon="Forward"
       Foreground="{Binding ConnectionStatusControlBoxColor}" />
                    </StackPanel>
                    <!-- RF Gateway -->
                    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="10 0">

                        <Label Padding="5 0"
               Foreground="White"
               VerticalAlignment="Center"
               VerticalContentAlignment="Center">
                            RF Gateway
                        </Label>

                        <fa:IconImage Height="12"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Icon="Wifi"
                      Foreground="{Binding ConnectionStatusRFColor}" />
                    </StackPanel>

                 

                </StackPanel>


            </Grid>
        </Grid>

    </Grid>
</Window>