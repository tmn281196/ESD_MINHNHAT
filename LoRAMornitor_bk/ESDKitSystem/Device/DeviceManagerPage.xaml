<Page x:Class="ESDKitSystem.Device.DeviceManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
      xmlns:local="clr-namespace:ESDKitSystem.Device"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DeviceManager">

    <Grid>

        <StackPanel Orientation="Vertical" Margin="10" HorizontalAlignment="Left"  >



            <StackPanel  Margin="0 5" Orientation="Horizontal" >
                <StackPanel Orientation="Horizontal" Margin="0 0 5 0">
                    <Label FontWeight="Bold">RF Gateway</Label>
                    <fa:IconImage Margin="1" Height="12" HorizontalAlignment="left" VerticalAlignment="Center"  Icon="Wifi" />

                </StackPanel>

                <StackPanel Width="500" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal"  Margin="0,0,0,2" >
                        <ComboBox  x:Name="RFComboBoxPorts" Width="70" Height="24"   Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" ItemsSource="{Binding SerialPorts}" SelectedValue="{Binding Config.RFGatewayCOM}" />
                        <StackPanel Orientation="Horizontal" Margin="5 0" >
                            <Button Click="ReConnectRFConnectionButton_Click" Padding="5 0"  Height="24" Margin="0 0 2 0"  Cursor="Hand">OPEN</Button>
                            <Button Click="CloseRFConnectionButton_Click" Padding="5 0"  Height="24" Margin="0 0 2 0" Cursor="Hand">CLOSE</Button>
                        </StackPanel>

                    </StackPanel>


                </StackPanel>
     
            </StackPanel>


            <StackPanel  Margin="0 5"  Orientation="Horizontal" >
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0 0 5 0">
                        <Label FontWeight="Bold">Control Box</Label>
                        <fa:IconImage Margin="1" Height="12" HorizontalAlignment="left" VerticalAlignment="Center"  Icon="Forward" />

                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ControlBoxComboBoxPorts" ItemsSource="{Binding SerialPorts}"  SelectedValue="{Binding Config.ControlBoxCOM}"   Width="70" Height="24"   Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Margin="5 0" >
                            <Button Click="ReConnectControlBoxConnectionButton_Click" Padding="5 0"  Height="24" Margin="0 0 2 0"  Cursor="Hand">OPEN</Button>
                            <Button Click="CloseControlBoxConnectionButton_Click" Padding="5 0"  Height="24" Margin="0 0 2 0" Cursor="Hand">CLOSE</Button>

                        </StackPanel>
                    </StackPanel>



                </StackPanel>
                <StackPanel   Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Button x:Name="ToggleableButton0" Click="SendControl_Click" Width="50" Height="24"  Cursor="Hand" Margin="1 0"  Content="MI"></Button>
                    <Button x:Name="ToggleableButton1" Click="SendControl_Click" Width="50" Height="24"  Cursor="Hand" Margin="1 0"  Content="Solder"></Button>
                    <Button x:Name="ToggleableButton2" Click="SendControl_Click" Width="50" Height="24"  Cursor="Hand" Margin="1 0"  Content="Packing"></Button>
                    <Button x:Name="ToggleableButton3" Click="SendControl_Click" Width="50" Height="24"  Cursor="Hand" Margin="1 0"  Content="FCT"></Button>
                    <Button x:Name="ToggleableButton4" Click="SendControl_Click" Width="50" Height="24"  Cursor="Hand" Margin="1 0"  Content="SW ON"></Button>

                 
                </StackPanel>
            </StackPanel>
       
            
            <Button   Click="ButtonRefresh_Click" HorizontalAlignment="Left"   Margin="0 5" Background="Transparent" Cursor="Hand" BorderThickness="0"  >
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Margin="5" Height="12" HorizontalAlignment="left" VerticalAlignment="Center"  Icon="Refresh" />

                </StackPanel>
            </Button>

        </StackPanel>

       
    </Grid>
</Page>
